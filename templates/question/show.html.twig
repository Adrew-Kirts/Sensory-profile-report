{% extends 'base.html.twig' %}

{% block title %}Questionnaire{% endblock %}

{% block body %}

    <div class="flex flex-col text-center">
        <a class="text-2xl">Profil sensoriel</a>
        {% set ageCategories = {
            0: 'nourrisson (0-6 mois)',
            1: 'jeune enfant (7-35 mois)',
            2: 'enfant (3-14 ans)',
            3: 'adulte/adolescent (11-65+ ans)',
            4: 'compagnon scolaire (3-14 ans)'
        } %}
        <a class="text-xl">{{ ageCategories[ageCategory] ?? 'Unknown' }}</a>
    </div>

    {% if patient is null %}
    <div class="w-full max-w-md mx-auto mt-6 p-6 bg-white shadow-lg rounded-lg text-center">
        {% if patients is empty %}
            <p class="mb-4">Aucun patient enregistré. Créez d'abord la fiche du patient pour remplir son profil sensoriel.</p>
        {% else %}
            <p class="mb-4">Choisissez le patient avant de remplir le profil sensoriel.</p>
            <form action="{{ path('question.indexByAge', {'ageCategory': ageCategory}) }}" method="GET">
                <select class="select select-accent w-full" name="patient" required>
                    <option disabled selected value="">Choisir patient</option>
                    {% for p in patients %}
                        <option value="{{ p.id }}">{{ p.firstName }} {{ p.lastName }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn btn-primary w-full mt-4">Commencer le profil</button>
            </form>
            <div class="divider">ou</div>
        {% endif %}
        <a href="{{ path('patient.create', {'ageCategory': ageCategory}) }}" class="btn btn-secondary w-full">Nouveau patient</a>
    </div>
    {% else %}
    <form action="{{ path('question.saveAnswers', {'ageCategory': ageCategory}) }}" method="POST">
        <input type="hidden" name="patientId" value="{{ patient.id }}">
        <p class="text-center mt-4">
            Patient : <strong>{{ patient.firstName }} {{ patient.lastName }}</strong>
            <a href="{{ path('question.indexByAge', {'ageCategory': ageCategory}) }}" class="link link-accent text-sm ml-2">changer</a>
        </p>

        <div class="sticky top-0 z-30 w-full shadow-md border-b border-gray-300" style="background-color: #f3f4f6;">
            <div class="max-w-4xl mx-auto p-3">
                <div class="flex justify-between text-center text-xs font-medium">
                    <div>5: Presque toujours = 90% ou plus</div>
                    <div class="border-l-2 border-gray-400 pl-2">4: Fréquemment = 75%</div>
                    <div class="border-l-2 border-gray-400 pl-2">3: Moitié du temps = 50%</div>
                    <div class="border-l-2 border-gray-400 pl-2">2: Parfois = 25%</div>
                    <div class="border-l-2 border-gray-400 pl-2">1: Presque jamais = 10% ou moins</div>
{#                    <div class="border-l-2 border-gray-400 pl-2">0: Ne s'applique pas</div>#}
                </div>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="table">
                <thead>
                <tr>
                    <th>Numéro</th>
                    <th>Question</th>
                    <th>Réponse</th>
                </tr>
                </thead>
                <tbody>
                {% for question in questions %}
                    <tr class="hover:bg-accent">
                        <td>{{ question.questionNumber }}</td>
                        <td class="tooltip-info" data-tip="5: presque toujours, 4: fréquemment, 3: moitié du temps, 2: parfois, 1: presque jamais, 0: ne s'applique pas">{{ question.questionText }}</td>
                        <td class="flex flex-row-reverse justify-around">
                            {% for i in 0..5 %}
                                <div class="text-center flex flex-col items-center px-1">
                                    <label for="answer{{ i }}_{{ question.id }}">{{ i }}</label>
                                    <input type="radio" id="answer{{ i }}_{{ question.id }}"
                                           name="answers[{{ question.id }}]"
                                           value="{{ i }}" required/>
                                </div>
                            {% endfor %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            <button type="submit" class="btn btn-primary w-full mt-4">Enregistrer</button>
        </div>
    </form>
    {% endif %}

{% endblock %}

