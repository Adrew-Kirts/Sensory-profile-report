{% for type, messages in app.flashes %}
    {% set alertClass = {
        'error': 'bg-red-100 text-red-900 border-red-500',
        'success': 'bg-green-100 text-green-900 border-green-500',
        'warning': 'bg-yellow-100 text-yellow-900 border-yellow-500',
        'info': 'bg-blue-100 text-blue-900 border-blue-500'
    }[type]|default('bg-blue-100 text-blue-900 border-blue-500') %}

    <div role="alert" class="alert flex items-center gap-2 p-3 rounded-md border {{ alertClass }} w-max m-4 cursor-pointer hover:opacity-80 transition-opacity">
        <span>
            {{ messages | join('. ') }}
        </span>
    </div>
{% endfor %}

<script>
    document.querySelectorAll('.alert').forEach(function(alert) {
        alert.addEventListener('click', function() {
            this.remove();
        });

        setTimeout(function() {
            alert.remove();
        }, 4500);
    });
</script>