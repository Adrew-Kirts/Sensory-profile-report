{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto p-6">
        <h1 class="text-2xl font-bold mb-6">Mon profil</h1>

        <div class="card bg-base-100 shadow-md border border-gray-200">
            <div class="card-body space-y-3">
                <div>
                    <span class="font-semibold">Nom d'utilisateur:</span>
                    <span>{{ user.username }}</span>
                </div>
                <div>
                    <span class="font-semibold">Prénom:</span>
                    <span>{{ user.firstName }}</span>
                </div>
                <div>
                    <span class="font-semibold">Nom de famille:</span>
                    <span>{{ user.lastName }}</span>
                </div>
                <div>
                    <span class="font-semibold">Email:</span>
                    <span>{{ user.email }}</span>
                </div>
                <div>
                    <span class="font-semibold">Compte créé le:</span>
                    <span>{{ user.createdAt | date('d-m-Y') }}</span>
                </div>
            </div>
        </div>

        <h2 class="text-xl font-bold mt-8 mb-4">Statistiques</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="card bg-base-100 shadow-md border border-gray-200">
                <div class="card-body">
                    <div class="text-3xl font-bold">{{ patientCount }}</div>
                    <div class="text-sm text-gray-600">Patient{{ patientCount > 1 ? 's' : '' }}</div>
                </div>
            </div>
            <div class="card bg-base-100 shadow-md border border-gray-200">
                <div class="card-body">
                    <div class="text-3xl font-bold">{{ surveyCount }}</div>
                    <div class="text-sm text-gray-600">Profil{{ surveyCount > 1 ? 's' : '' }} sensoriel{{ surveyCount > 1 ? 's' : '' }}</div>
                </div>
            </div>
        </div>

        <div class="mt-8">
            <a href="{{ path('home') }}" class="btn btn-secondary btn-sm">Retour à l'accueil</a>
        </div>
    </div>
{% endblock %}
