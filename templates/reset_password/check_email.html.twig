{% extends 'base.html.twig' %}

{% block title %}Email envoyé{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-start justify-center bg-white pt-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-md w-full space-y-6 bg-white p-8 rounded-lg shadow-lg text-center">
            <h1 class="text-3xl font-extrabold text-gray-900">Vérifiez vos emails</h1>
            <p class="text-gray-700">
                Si un compte correspond à cette adresse, un email contenant un lien de réinitialisation vient d'être envoyé.
                Ce lien expire dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
            </p>
            <p class="text-sm text-gray-600">
                Rien reçu ? Pensez à vérifier vos spams, ou <a href="{{ path('app_forgot_password_request') }}" class="font-medium text-accent hover:underline">réessayez</a>.
            </p>
        </div>
    </div>
{% endblock %}
