{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-start justify-center bg-white pt-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-md w-full space-y-6 bg-white p-8 rounded-lg shadow-lg">
            <h1 class="text-3xl font-extrabold text-gray-900 text-center">Mot de passe oublié</h1>
            <p class="text-sm text-gray-600 text-center">
                Entrez l'adresse email de votre compte. Vous recevrez un lien pour choisir un nouveau mot de passe.
            </p>

            {{ form_start(requestForm) }}
                {{ form_row(requestForm.email, {'attr': {'class': 'input input-bordered w-full'}}) }}
                <button type="submit" class="btn btn-primary w-full mt-4">Envoyer le lien</button>
            {{ form_end(requestForm) }}

            <div class="text-center text-sm text-gray-600">
                <a href="{{ path('app_login') }}" class="font-medium text-accent hover:underline">Retour à la connexion</a>
            </div>
        </div>
    </div>
{% endblock %}
