{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-start justify-center bg-white pt-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-md w-full space-y-6 bg-white p-8 rounded-lg shadow-lg">
            <h1 class="text-3xl font-extrabold text-gray-900 text-center">Nouveau mot de passe</h1>

            {{ form_start(resetForm) }}
                {{ form_row(resetForm.plainPassword.first, {'attr': {'class': 'input input-bordered w-full'}}) }}
                {{ form_row(resetForm.plainPassword.second, {'attr': {'class': 'input input-bordered w-full'}}) }}
                <button type="submit" class="btn btn-primary w-full mt-4">Enregistrer</button>
            {{ form_end(resetForm) }}
        </div>
    </div>
{% endblock %}
